  {"default": "Second Price", "depends_on": "eval:doc.auction_type=='Sealed'", "description": "First Price: the winner pays their bid. Second Price: the winner pays the runner-up's bid (or the start price or reserve, if higher).", "fieldname": "sealed_pricing", "fieldtype": "Select", "label": "Sealed Pricing", "mandatory_depends_on": "eval:doc.auction_type=='Sealed'", "options": "First Price\nSecond Price"},
  {"description": "English and Sealed: the lowest first bid. Dutch: where the price starts.", "fieldname": "start_price", "fieldtype": "Currency", "label": "Start Price", "options": "currency", "reqd": 1},
  {"depends_on": "eval:doc.auction_type!='Dutch'", "description": "Never shown. Below it the lot goes unsold. Blank: no reserve.", "fieldname": "reserve_price", "fieldtype": "Currency", "label": "Reserve Price", "options": "currency"},
  {"fieldname": "column_break_format", "fieldtype": "Column Break"},
  {"depends_on": "eval:doc.auction_type=='English'", "fieldname": "bid_increment", "fieldtype": "Currency", "label": "Bid Increment", "mandatory_depends_on": "eval:doc.auction_type=='English'", "options": "currency"},
  {"default": "2", "depends_on": "eval:doc.auction_type=='English'", "description": "A bid this close to the end moves the end to this long after the bid. 0: never.", "fieldname": "extend_window_minutes", "fieldtype": "Int", "label": "Extend on Late Bid (Minutes)", "non_negative": 1},
  {"depends_on": "eval:doc.auction_type=='Dutch'", "description": "The price stops dropping here.", "fieldname": "floor_price", "fieldtype": "Currency", "label": "Floor Price", "mandatory_depends_on": "eval:doc.auction_type=='Dutch'", "options": "currency"},
  {"depends_on": "eval:doc.auction_type=='Dutch'", "fieldname": "price_step", "fieldtype": "Currency", "label": "Price Drop per Step", "mandatory_depends_on": "eval:doc.auction_type=='Dutch'", "options": "currency"},
  {"default": "60", "depends_on": "eval:doc.auction_type=='Dutch'", "fieldname": "step_interval_seconds", "fieldtype": "Int", "label": "Step Interval (Seconds)", "mandatory_depends_on": "eval:doc.auction_type=='Dutch'", "non_negative": 1},
  {"fieldname": "schedule_section", "fieldtype": "Section Break", "label": "Schedule"},
  {"fieldname": "starts_at", "fieldtype": "Datetime", "in_list_view": 1, "label": "Starts At", "reqd": 1, "search_index": 1},
  {"fieldname": "column_break_schedule", "fieldtype": "Column Break"},
