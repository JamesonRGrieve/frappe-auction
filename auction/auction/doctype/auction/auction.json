  {"fieldname": "company", "fieldtype": "Link", "in_standard_filter": 1, "label": "Company", "options": "Company", "reqd": 1},
  {"fetch_from": "company.default_currency", "fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency", "read_only": 1},
  {"default": "1", "description": "English and Sealed: the lot's size, sold together. Dutch: units on offer; each buyer takes as many as they choose.", "fieldname": "quantity", "fieldtype": "Float", "label": "Quantity", "non_negative": 1, "reqd": 1},
  {"description": "Where the winner's Sales Order delivers from.", "fieldname": "warehouse", "fieldtype": "Link", "label": "Warehouse", "options": "Warehouse"},
  {"fieldname": "description", "fieldtype": "Text Editor", "label": "Description"},
  {"fieldname": "format_section", "fieldtype": "Section Break", "label": "Format"},
