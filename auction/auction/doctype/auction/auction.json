  {"fieldname": "settlement_section", "fieldtype": "Section Break", "label": "Settlement"},
  {"description": "Applied to the winner's Sales Order.", "fieldname": "taxes_and_charges", "fieldtype": "Link", "label": "Sales Taxes and Charges Template", "options": "Sales Taxes and Charges Template"},
  {"fieldname": "column_break_settlement", "fieldtype": "Column Break"},
  {"description": "Set: the winner is emailed a Payment Request through this gateway. Blank: no Payment Request; staff collect payment.", "fieldname": "payment_gateway_account", "fieldtype": "Link", "label": "Payment Gateway Account", "options": "Payment Gateway Account"},
  {"fieldname": "web_section", "fieldtype": "Section Break", "label": "Web Page"},
  {"default": "0", "fieldname": "published", "fieldtype": "Check", "in_standard_filter": 1, "label": "Published"},
  {"fieldname": "column_break_web", "fieldtype": "Column Break"},
  {"fieldname": "route", "fieldtype": "Data", "label": "Route", "no_copy": 1, "unique": 1},
  {"fieldname": "status_section", "fieldtype": "Section Break", "label": "Status"},
  {"default": "Scheduled", "fieldname": "status", "fieldtype": "Select", "in_list_view": 1, "in_standard_filter": 1, "label": "Status", "no_copy": 1, "options": "Scheduled\nOpen\nSold\nUnsold", "read_only": 1, "search_index": 1},
  {"description": "English: the leading price. Sealed: blank until the close. Dutch: the last price paid.", "fieldname": "current_price", "fieldtype": "Currency", "label": "Current Price", "no_copy": 1, "options": "currency", "read_only": 1},
  {"default": "0", "fieldname": "bid_count", "fieldtype": "Int", "label": "Bids", "no_copy": 1, "read_only": 1},
  {"fieldname": "column_break_status", "fieldtype": "Column Break"},
  {"default": "0", "depends_on": "eval:doc.auction_type=='Dutch'", "fieldname": "units_sold", "fieldtype": "Float", "label": "Units Sold", "no_copy": 1, "read_only": 1},
  {"depends_on": "eval:doc.auction_type!='Dutch'", "fieldname": "winning_bidder", "fieldtype": "Link", "label": "Winning Bidder", "no_copy": 1, "options": "User", "read_only": 1},
  {"depends_on": "eval:doc.auction_type!='Dutch'", "fieldname": "winning_customer", "fieldtype": "Link", "label": "Winning Customer", "no_copy": 1, "options": "Customer", "read_only": 1},
  {"depends_on": "eval:doc.auction_type!='Dutch'", "description": "Dutch: each buyer's order is on their Auction Bid.", "fieldname": "sales_order", "fieldtype": "Link", "label": "Sales Order", "no_copy": 1, "options": "Sales Order", "read_only": 1},
  {"fieldname": "closed_at", "fieldtype": "Datetime", "label": "Closed At", "no_copy": 1, "read_only": 1},
  {"depends_on": "settlement_error", "description": "Settling this auction failed with this error and is not retried. Fix the cause, then clear this to retry within a minute.", "fieldname": "settlement_error", "fieldtype": "Small Text", "label": "Settlement Error", "no_copy": 1}
 ],
