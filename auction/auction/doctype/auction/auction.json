  {"fetch_from": "item.item_name", "fieldname": "item_name", "fieldtype": "Data", "label": "Item Name", "read_only": 1},
  {"fetch_from": "item.image", "fetch_if_empty": 1, "fieldname": "image", "fieldtype": "Attach Image", "label": "Image"},
